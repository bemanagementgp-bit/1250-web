<%- include('partials/head') %>
<% const W = (slug) => bySlug[slug]; %>

<main id="main">
  <!-- ============================================================ HERO -->
  <section class="theme-dark bg-bg relative overflow-hidden" data-theme="dark" data-hero>
    <div class="pointer-events-none absolute inset-0" aria-hidden="true">
      <div class="hero-mesh absolute inset-0" data-hero-mesh><span></span><span></span><span></span></div>
      <div class="hero-grid absolute inset-0"></div>
    </div>

    <div class="container-x relative pb-16 pt-28 lg:pb-24 lg:pt-36">
      <div class="grid grid-cols-2 gap-6 border-t border-fg/10 pt-4 font-mono text-[0.65rem] uppercase tracking-[0.18em] text-fg/55 lg:grid-cols-6" data-hero-fade>
        <span><%= L.hero.eyebrow %></span>
        <span class="hidden lg:col-span-2 lg:block"><%= L.proof.sectors.map(s => s.name).join(' · ') %></span>
        <span class="text-right lg:col-start-6">+<%= L.proof.stat %> <%= L.proof.statLabel.toLowerCase() %></span>
      </div>

      <div class="mt-14 grid gap-12 lg:mt-20 lg:grid-cols-12 lg:items-end">
        <h1 class="display accent-em text-[clamp(3rem,7.6vw,9rem)] leading-[0.9] lg:col-span-9">
          <% L.hero.lines.forEach((line, i) => { %>
            <span class="line-mask"><span class="block <%= i === 1 ? 'lg:pl-[6vw]' : '' %>" data-hero-line><%- line %></span></span>
          <% }) %>
        </h1>
        <div class="lg:col-span-3" data-hero-fade>
          <div class="relative mx-auto grid aspect-square w-40 place-items-center lg:w-full lg:max-w-[15rem]" aria-hidden="true">
            <svg viewBox="0 0 200 200" class="spin-slow absolute inset-0 h-full w-full" style="animation-duration: 24s">
              <defs><path id="lp-circle" d="M100,100 m-80,0 a80,80 0 1,1 160,0 a80,80 0 1,1 -160,0"/></defs>
              <text class="fill-bone/60 font-mono text-[11px] uppercase tracking-[0.3em]"><textPath href="#lp-circle">Retail · Gastronomía · Oficinas · Salud · Entretenimiento · </textPath></text>
            </svg>
            <span class="bg-brand grid h-[58%] w-[58%] place-items-center rounded-full text-center text-bone">
              <span><span class="display block text-4xl lg:text-5xl">+<span data-count="<%= L.proof.stat %>">0</span></span><span class="mt-1 block font-mono text-[0.58rem] uppercase tracking-[0.16em] opacity-80"><%= L.proof.statLabel %></span></span>
            </span>
          </div>
        </div>
      </div>

      <div class="mt-12 grid gap-8 border-t border-fg/10 pt-8 lg:mt-16 lg:grid-cols-12 lg:items-center" data-hero-fade>
        <p class="max-w-2xl text-lg leading-relaxed text-fg/75 lg:col-span-7 lg:text-xl [&_strong]:font-medium [&_strong]:text-fg"><%- L.hero.intro %></p>
        <div class="flex flex-wrap items-center gap-3 lg:col-span-5 lg:justify-end">
          <a href="#contacto" class="btn-brand" data-anchor data-magnetic><span><%= L.hero.cta %></span><span aria-hidden="true">→</span></a>
          <a href="#etapas" class="btn-pill" data-anchor data-magnetic><span><%= L.hero.secondary %></span><span aria-hidden="true">↓</span></a>
        </div>
      </div>
    </div>

    <!-- Tira de locales reales -->
    <div class="relative pb-20 lg:pb-28" data-lp-strip>
      <div class="flex w-max gap-4 px-[clamp(1.25rem,4vw,4rem)] lg:gap-6" data-lp-strip-track>
        <% L.hero.strip.forEach((slug, i) => { const w = W(slug); if (!w) return; %>
          <figure class="relative shrink-0 overflow-hidden rounded-2xl bg-card <%= ['aspect-[4/5] w-[62vw] sm:w-[34vw] lg:w-[22vw]', 'aspect-[3/4] w-[54vw] sm:w-[28vw] lg:w-[18vw] mt-16', 'aspect-[16/11] w-[78vw] sm:w-[44vw] lg:w-[30vw] mt-6', 'aspect-[4/5] w-[60vw] sm:w-[32vw] lg:w-[20vw] mt-20', 'aspect-[3/4] w-[56vw] sm:w-[30vw] lg:w-[19vw]'][i] %>">
            <div class="img-reveal absolute inset-0" data-reveal>
              <%- pic(w.cover, { alt: w.title, sizes: '(min-width:1024px) 30vw, 78vw', cls: 'block h-full w-full', imgCls: 'h-full w-full scale-[1.12] object-cover', eager: i < 2, attrs: 'data-parallax-img' }) %>
            </div>
            <figcaption class="absolute inset-x-3 bottom-3 flex items-center justify-between rounded-full bg-ink/55 px-3 py-1.5 text-xs text-bone backdrop-blur">
              <span><%= w.title %></span><span class="opacity-60"><%= w.industry.split(' / ')[0] %></span>
            </figcaption>
          </figure>
        <% }) %>
      </div>
    </div>
  </section>

  <!-- ============================================================ ENFOQUE (claro) -->
  <section class="theme-light bg-bg" data-theme="light">
    <div class="container-x section-y">
      <div class="mb-16 grid gap-8 lg:mb-24 lg:grid-cols-12 lg:items-end">
        <p class="eyebrow lg:col-span-3">(01) — <%= L.pillars.eyebrow %></p>
        <h2 class="display text-huge accent-em lg:col-span-9" data-split-lines><%- L.pillars.title %></h2>
      </div>
      <div class="grid gap-4 md:grid-cols-3" data-stagger>
        <% L.pillars.items.forEach((p, i) => { %>
          <article class="<%= i === 1 ? 'theme-brand bg-brand' : 'bg-card' %> group flex min-h-[20rem] flex-col justify-between rounded-3xl p-7 lg:min-h-[26rem] lg:p-10">
            <div class="flex items-start justify-between">
              <span class="font-mono text-xs opacity-60">0<%= i + 1 %></span>
              <span class="grid h-12 w-12 place-items-center rounded-full border border-current/25 transition-transform duration-700 ease-[var(--ease-expo)] group-hover:rotate-90" aria-hidden="true">
                <% if (i === 0) { %><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="3"/></svg><% } %>
                <% if (i === 1) { %><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 3l2.4 6.6L21 12l-6.6 2.4L12 21l-2.4-6.6L3 12l6.6-2.4z"/></svg><% } %>
                <% if (i === 2) { %><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 20V9l8-5 8 5v11M9 20v-6h6v6"/></svg><% } %>
              </span>
            </div>
            <div>
              <h3 class="display text-[clamp(2rem,3vw,3.2rem)]"><%= p.title %></h3>
              <p class="mt-5 text-lg leading-relaxed opacity-75"><%= p.text %></p>
            </div>
          </article>
        <% }) %>
      </div>
      <div class="mt-14 flex flex-wrap items-center justify-between gap-6 border-t border-fg/15 pt-8">
        <p class="max-w-xl text-lg text-fg/70"><%= L.form.reassurance[1] %>. <%= L.form.reassurance[0] %>.</p>
        <a href="#contacto" class="btn-brand" data-anchor data-magnetic><span><%= L.hero.cta %></span><span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <!-- ============================================================ ETAPAS (oscuro) -->
  <section id="etapas" class="theme-dark bg-bg relative overflow-hidden" data-theme="dark" data-method="vertical">
    <div class="container-x section-y">
      <div class="grid gap-14 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <div class="lg:sticky lg:top-32">
            <p class="eyebrow mb-6">(02) — <%= L.stages.eyebrow %></p>
            <h2 class="display text-huge accent-em" data-split-lines><%- L.stages.title %></h2>
          </div>
        </div>
        <div class="relative lg:col-span-7">
          <div class="absolute left-[1.35rem] top-0 h-full w-px bg-fg/15" aria-hidden="true">
            <span class="absolute inset-0 origin-top scale-y-0 bg-signal" data-method-line></span>
          </div>
          <ol class="relative grid gap-6">
            <% L.stages.items.forEach((s, i) => { %>
              <li class="group relative pl-16" data-step>
                <span class="absolute left-0 top-0 grid h-11 w-11 place-items-center rounded-full border border-fg/25 bg-bg font-mono text-xs transition-all duration-500 group-[.is-active]:border-transparent group-[.is-active]:bg-brand-600 group-[.is-active]:text-bone">0<%= i + 1 %></span>
                <div class="relative overflow-hidden rounded-3xl border border-fg/12 bg-card p-7 transition-all duration-700 ease-[var(--ease-expo)] group-[.is-active]:border-brand-400/60 group-[.is-active]:bg-brand-900/60 lg:p-10">
                  <span class="display pointer-events-none absolute -right-2 -top-6 text-[9rem] leading-none text-fg/[0.05] transition-colors duration-700 group-[.is-active]:text-signal/15 lg:text-[12rem]" aria-hidden="true"><%= i + 1 %>.</span>
                  <h3 class="display relative text-[clamp(2rem,3.4vw,3.4rem)]"><%= s.title %><% if (s.note) { %> <em class="text-accent">(<%= s.note.toLowerCase() %>)</em><% } %></h3>
                  <p class="relative mt-6 max-w-lg text-lg leading-relaxed text-fg/70"><%= s.text %></p>
                </div>
              </li>
            <% }) %>
          </ol>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================ RUBROS (violeta) -->
  <section class="theme-brand bg-brand relative overflow-hidden" data-theme="brand" data-sectors>
    <div class="hero-mesh pointer-events-none absolute inset-0 opacity-50" aria-hidden="true"><span></span><span></span><span></span></div>
    <div class="container-x section-y relative grid gap-12 lg:grid-cols-12 lg:items-center">
      <div class="lg:col-span-6">
        <p class="eyebrow mb-8 !text-fg/75">(03) — <%= L.proof.eyebrow %></p>
        <p class="display text-[clamp(5rem,15vw,15rem)] leading-[0.8]">+<span data-count="<%= L.proof.stat %>">0</span></p>
        <p class="mt-4 font-serif text-3xl italic text-fg/85 lg:text-4xl"><%= L.proof.statLabel %></p>

        <ul class="mt-12 border-t border-bone/25" role="list">
          <% L.proof.sectors.forEach((s, i) => { %>
            <li>
              <button type="button" class="group flex w-full items-center justify-between gap-6 border-b border-bone/25 py-4 text-left lg:py-5" data-sector="<%= i %>" aria-pressed="<%= i === 0 %>">
                <span class="display text-[clamp(2rem,4vw,3.6rem)] opacity-50 transition-all duration-500 group-hover:translate-x-2 group-hover:opacity-100 group-aria-pressed:translate-x-2 group-aria-pressed:opacity-100"><%= s.name %></span>
                <span class="font-mono text-xs opacity-0 transition-opacity duration-500 group-aria-pressed:opacity-70"><%= W(s.work) ? W(s.work).title : '' %></span>
              </button>
            </li>
          <% }) %>
        </ul>
      </div>
      <div class="lg:col-span-5 lg:col-start-8">
        <div class="relative aspect-[4/5] overflow-hidden rounded-3xl bg-brand-900/40 shadow-[0_40px_120px_rgba(20,8,45,.45)]">
          <% L.proof.sectors.forEach((s, i) => { const w = W(s.work); if (!w) return; %>
            <div class="absolute inset-0 <%= i ? 'opacity-0' : '' %>" data-sector-img="<%= i %>">
              <%- pic(w.cover, { alt: `${s.name} — ${w.title}`, sizes: '(min-width:1024px) 40vw, 90vw', cls: 'block h-full w-full', imgCls: 'h-full w-full object-cover' }) %>
            </div>
          <% }) %>
          <div class="pointer-events-none absolute inset-x-0 bottom-0 h-1/3 bg-gradient-to-t from-ink/60 to-transparent"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================ GALERÍA (oscuro) -->
  <section class="theme-dark bg-bg overflow-hidden py-16 lg:py-24" data-theme="dark" aria-label="Locales diseñados por 1250">
    <div class="mask-fade-x flex overflow-hidden">
      <div class="marquee-track flex w-max" style="--dur:60s">
        <% for (let k = 0; k < 2; k++) { %>
          <ul class="flex shrink-0 gap-4 pr-4 lg:gap-6 lg:pr-6" <%= k ? 'aria-hidden=true' : '' %>>
            <% L.proof.gallery.forEach(slug => { const w = W(slug); if (!w) return; %>
              <li class="relative aspect-[4/3] w-[70vw] shrink-0 overflow-hidden rounded-2xl sm:w-[40vw] lg:w-[26vw]">
                <%- pic(w.cover, { alt: k ? '' : w.title, sizes: '(min-width:1024px) 26vw, 70vw', cls: 'block h-full w-full', imgCls: 'h-full w-full object-cover' }) %>
                <span class="absolute bottom-3 left-3 rounded-full bg-ink/55 px-3 py-1.5 text-xs text-bone backdrop-blur"><%= w.title %></span>
              </li>
            <% }) %>
          </ul>
        <% } %>
      </div>
    </div>
  </section>

  <!-- ============================================================ FORMULARIO -->
  <section id="contacto" class="theme-dark bg-bg relative overflow-hidden" data-theme="dark">
    <div class="hero-mesh pointer-events-none absolute inset-0 opacity-70" aria-hidden="true"><span></span><span></span><span></span></div>
    <div class="container-x section-y relative grid gap-14 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <div class="lg:sticky lg:top-32">
          <p class="eyebrow mb-6">(04) — <%= L.form.eyebrow %></p>
          <h2 class="display accent-em text-[clamp(2.4rem,4.4vw,4.6rem)]" data-split-lines><%- L.form.title %></h2>
          <ul class="mt-10 space-y-3">
            <% L.form.reassurance.forEach(r => { %>
              <li class="flex items-center gap-3 text-lg text-fg/80"><span class="bg-brand grid h-6 w-6 shrink-0 place-items-center rounded-full text-xs text-bone" aria-hidden="true">✓</span><%= r %></li>
            <% }) %>
          </ul>
        </div>
      </div>

      <div class="lg:col-span-7">
        <form class="theme-light bg-bg relative rounded-3xl p-6 sm:p-10 lg:p-12" data-lead-form novalidate>
          <input type="text" name="website" tabindex="-1" autocomplete="off" class="absolute -left-[9999px] h-px w-px opacity-0" aria-hidden="true">
          <% ['utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content', 'gclid', 'fbclid'].forEach(k => { %><input type="hidden" name="<%= k %>"><% }) %>
          <input type="hidden" name="referrer">
          <input type="hidden" name="landing" value="espacios">

          <div class="grid gap-x-6 sm:grid-cols-2">
            <%
              const F = L.form.fields;
              const fields = [
                { name: 'name', type: 'text', auto: 'name', req: true, col: 'sm:col-span-2' },
                { name: 'whatsapp', type: 'tel', auto: 'tel', req: true, mode: 'tel' },
                { name: 'email', type: 'email', auto: 'email', req: true, mode: 'email' },
                { name: 'company', type: 'text', auto: 'organization', req: false, col: 'sm:col-span-2' },
              ];
            %>
            <% fields.forEach(f => { const c = F[f.name]; %>
              <label class="group relative block border-b border-fg/20 pb-3 pt-7 transition-colors focus-within:border-brand-600 has-[[aria-invalid=true]]:border-red-600 <%= f.col || '' %>">
                <span class="flex items-baseline justify-between gap-3 font-mono text-[0.68rem] uppercase tracking-[0.14em] text-fg/55">
                  <span><%= c.label %><%= f.req ? ' *' : '' %></span>
                  <% if (c.hint) { %><span class="normal-case tracking-normal text-accent"><%= c.hint %></span><% } %>
                </span>
                <input name="<%= f.name %>" type="<%= f.type %>" autocomplete="<%= f.auto %>" <%= f.mode ? `inputmode=${f.mode}` : '' %> <%= f.req ? 'required' : '' %> placeholder="<%= c.placeholder %>" class="mt-2 w-full bg-transparent text-xl tracking-tight outline-none placeholder:text-fg/30 lg:text-2xl">
                <span class="mt-1 hidden text-sm text-red-700 group-has-[[aria-invalid=true]]:block" data-error-for="<%= f.name %>"></span>
              </label>
            <% }) %>

            <fieldset class="border-b border-fg/20 py-7 sm:col-span-2">
              <legend class="font-mono text-[0.68rem] uppercase tracking-[0.14em] text-fg/55"><%= F.stage.label %> *</legend>
              <div class="mt-4 flex flex-wrap gap-2" data-stage-group>
                <% L.form.stages.forEach((s, i) => { %>
                  <label class="cursor-pointer">
                    <input type="radio" name="stage" value="<%= s %>" class="peer sr-only" <%= i === 0 ? 'required' : '' %>>
                    <span class="chip inline-block peer-checked:border-brand-600 peer-checked:bg-brand-600 peer-checked:text-bone peer-focus-visible:outline-2 peer-focus-visible:outline-brand-600"><%= s %></span>
                  </label>
                <% }) %>
              </div>
              <span class="mt-3 hidden text-sm text-red-700" data-error-for="stage"></span>
            </fieldset>

            <label class="relative block border-b border-fg/20 pb-3 pt-7 transition-colors focus-within:border-brand-600 sm:col-span-2">
              <span class="font-mono text-[0.68rem] uppercase tracking-[0.14em] text-fg/55"><%= F.message.label %></span>
              <textarea name="message" rows="3" placeholder="<%= F.message.placeholder %>" class="mt-2 w-full resize-none bg-transparent text-xl tracking-tight outline-none placeholder:text-fg/30 lg:text-2xl"></textarea>
            </label>
          </div>

          <div class="mt-10 flex flex-wrap items-center justify-between gap-6">
            <p class="max-w-xs text-sm text-fg/55" data-form-status role="status" aria-live="polite"><%= L.form.privacy %></p>
            <button type="submit" class="btn-brand !px-8 !py-5 !text-base" data-magnetic><span data-submit-label><%= L.form.submit %></span><span aria-hidden="true">→</span></button>
          </div>

          <!-- Estado de éxito -->
          <div class="theme-brand bg-brand absolute inset-0 hidden flex-col items-start justify-end rounded-3xl p-8 sm:p-12" data-lead-success tabindex="-1">
            <span class="grid h-16 w-16 place-items-center rounded-full bg-bone text-2xl text-brand-600" aria-hidden="true">✓</span>
            <p class="display mt-10 text-[clamp(2.2rem,4vw,4rem)]"><%= L.form.success.title %></p>
            <p class="mt-5 max-w-md text-lg text-fg/85"><%= L.form.success.text %></p>
            <a href="https://wa.me/<%= L.whatsapp.number %>" target="_blank" rel="noopener" class="mt-8 inline-flex items-center gap-3 rounded-full bg-bone px-6 py-4 font-medium text-brand-600 transition-transform duration-500 hover:scale-[1.03]" data-wa-link>
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.66 15l-1.3 4.76 4.88-1.28A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.18-1.15l-.3-.18-2.9.76.78-2.83-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.14c-.25-.12-1.46-.72-1.69-.8s-.39-.12-.55.12-.63.8-.78.97-.29.18-.54.06a6.73 6.73 0 0 1-3.37-2.94c-.25-.44.25-.41.72-1.36a.45.45 0 0 0-.02-.43c-.06-.12-.55-1.33-.76-1.82s-.4-.41-.55-.42h-.47a.9.9 0 0 0-.66.31 2.77 2.77 0 0 0-.86 2.06 4.82 4.82 0 0 0 1 2.55 11 11 0 0 0 4.2 3.72c1.56.67 2.17.73 2.95.62a2.52 2.52 0 0 0 1.66-1.17 2.05 2.05 0 0 0 .14-1.17c-.06-.1-.22-.16-.47-.28Z"/></svg>
              <span><%= L.form.success.button %></span>
            </a>
          </div>
        </form>
      </div>
    </div>
  </section>
</main>

<footer class="theme-dark bg-bg border-t border-fg/10" data-theme="dark">
  <div class="container-x flex flex-col justify-between gap-4 py-8 text-sm text-fg/60 sm:flex-row sm:items-center">
    <div class="flex flex-wrap items-center gap-x-8 gap-y-2">
      <a class="link-u" href="<%= mainSite %>" rel="noopener">www.1250.com.ar</a>
      <a class="link-u" href="https://wa.me/<%= L.whatsapp.number %>?text=<%= encodeURIComponent(L.whatsapp.greeting) %>" target="_blank" rel="noopener">WhatsApp <%= L.whatsapp.display %></a>
    </div>
    <span class="font-mono text-[0.62rem] uppercase tracking-[0.18em] text-fg/45">© <%= year %> 1250</span>
  </div>
</footer>

<!-- CTA fijo en móvil -->
<a href="#contacto" class="bg-brand fixed inset-x-4 bottom-4 z-[60] flex translate-y-[150%] items-center justify-between rounded-full px-6 py-4 text-base font-medium text-bone shadow-[0_20px_60px_rgba(20,8,45,.5)] transition-transform duration-700 ease-[var(--ease-expo)] md:hidden" data-anchor data-sticky-cta>
  <span><%= L.stickyCta %></span><span aria-hidden="true">→</span>
</a>

<script>window.LANDING = <%- JSON.stringify({ sending: L.form.sending, submit: L.form.submit, errors: L.form.errors, whatsapp: L.whatsapp, labels: { name: L.form.fields.name.label, company: L.form.fields.company.label, stage: L.form.fields.stage.label, whatsapp: L.form.fields.whatsapp.label, email: L.form.fields.email.label, message: 'Más info' } }) %>;</script>
<%- include('partials/scripts') %>
