<%- include('partials/head') %>
<%
  // Galería: las verticales se agrupan de a dos; el resto va a ancho completo con su proporción real.
  const rows = [];
  const portrait = (rel) => ratio(rel) < 0.95;
  for (let k = 0; k < work.gallery.length; k++) {
    const a = work.gallery[k];
    const b = work.gallery[k + 1];
    if (b && portrait(a) && portrait(b)) { rows.push([a, b]); k++; }
    else rows.push([a]);
  }
  const [lead, ...rest] = work.description;
%>

<main id="main">
  <section class="theme-dark bg-bg relative h-[100svh] min-h-[560px] overflow-hidden" data-theme="dark" data-work-hero>
    <div class="absolute inset-0" data-work-cover>
      <%- pic(work.cover, { alt: work.title, sizes: '100vw', cls: 'block h-full w-full', imgCls: 'h-full w-full scale-110 object-cover', eager: true }) %>
      <div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/25 to-ink/45"></div>
    </div>
    <div class="container-x relative flex h-full flex-col justify-end pb-10 lg:pb-16">
      <a href="<%= url('works') %>" class="eyebrow mb-8 inline-flex items-center gap-2 !text-bone/70 hover:!text-bone" data-hero-fade>← <%= t.work.back %> / <%= String(work.index + 1).padStart(2, '0') %></a>
      <h1 class="display text-giant text-bone" data-split-hero><%= work.title %></h1>
      <div class="mt-6 flex flex-wrap items-end justify-between gap-6" data-hero-fade>
        <p class="font-serif text-3xl italic text-bone/85 lg:text-5xl"><%= work.tagline %></p>
        <div class="flex flex-wrap gap-2">
          <% work.services.forEach(s => { %><span class="rounded-full border border-bone/25 px-3 py-1.5 text-sm text-bone/85 backdrop-blur"><%= s %></span><% }) %>
        </div>
      </div>
    </div>
  </section>

  <section class="theme-light bg-bg" data-theme="light">
    <div class="container-x section-y">
      <div class="grid gap-14 lg:grid-cols-12">
        <aside class="lg:col-span-4">
          <dl class="grid grid-cols-2 gap-x-6 gap-y-8 border-t border-fg/15 pt-6 lg:sticky lg:top-32 lg:grid-cols-1" data-stagger>
            <div><dt class="eyebrow mb-2"><%= t.work.client %></dt><dd class="text-lg"><%= work.client %></dd></div>
            <div><dt class="eyebrow mb-2"><%= t.work.industry %></dt><dd class="text-lg"><%= work.industry %></dd></div>
            <div><dt class="eyebrow mb-2"><%= t.work.location %></dt><dd class="text-lg"><%= work.location %></dd></div>
            <div><dt class="eyebrow mb-2"><%= t.work.services %></dt><dd class="text-lg"><%= work.services.join(' / ') %></dd></div>
          </dl>
        </aside>
        <div class="lg:col-span-7 lg:col-start-6">
          <% if (lead) { %><p class="text-[clamp(1.5rem,2.6vw,2.6rem)] font-medium leading-[1.2] tracking-[-0.025em]" data-scrub-words><%= lead %></p><% } %>
          <% if (rest.length) { %>
            <div class="mt-12 grid gap-6 border-t border-fg/15 pt-10 text-lg leading-relaxed text-fg/70 <%= rest.length > 1 ? 'md:grid-cols-2 md:gap-10' : 'max-w-2xl' %>" data-stagger>
              <% rest.forEach(p => { %><p><%= p %></p><% }) %>
            </div>
          <% } %>
        </div>
      </div>
    </div>

    <div class="container-x pb-24 lg:pb-40" aria-label="<%= t.work.gallery %>">
      <div class="grid gap-4 lg:gap-6">
        <% rows.forEach(row => { %>
          <div class="grid gap-4 lg:gap-6 <%= row.length === 2 ? 'sm:grid-cols-2' : '' %>">
            <% row.forEach(src => { %>
              <figure class="relative overflow-hidden rounded-2xl bg-card" style="aspect-ratio: <%= ratio(src).toFixed(4) %>">
                <div class="img-reveal absolute inset-0" data-reveal>
                  <%- pic(src, { alt: `${work.title} — ${t.work.image}`, sizes: row.length === 2 ? '(min-width:640px) 46vw, 92vw' : '92vw', cls: 'block h-full w-full', imgCls: 'h-full w-full scale-[1.12] object-cover', attrs: 'data-parallax-img' }) %>
                </div>
              </figure>
            <% }) %>
          </div>
        <% }) %>
      </div>
    </div>
  </section>

  <section class="theme-dark bg-bg relative overflow-hidden" data-theme="dark">
    <a href="<%= url('work', next.slug) %>" class="group relative block section-y" data-cursor="<%= t.cursor.next %>">
      <div class="absolute inset-0 scale-110 opacity-0 transition-all duration-[1.2s] ease-[var(--ease-expo)] group-hover:scale-100 group-hover:opacity-40">
        <%- pic(next.cover, { sizes: '100vw', cls: 'block h-full w-full', imgCls: 'h-full w-full object-cover' }) %>
      </div>
      <div class="container-x relative">
        <p class="eyebrow mb-6"><%= t.work.next %></p>
        <p class="display text-giant transition-transform duration-700 ease-[var(--ease-expo)] group-hover:translate-x-6"><%= next.title %> <span class="inline-block text-accent transition-transform duration-700 group-hover:translate-x-6">→</span></p>
        <p class="mt-4 font-serif text-2xl italic text-fg/60"><%= next.tagline %></p>
      </div>
    </a>
  </section>
</main>

<%- include('partials/footer') %>
