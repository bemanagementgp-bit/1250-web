<%- include('partials/head') %>

<main id="main">
  <!-- ============================================================ PORTADA -->
  <section class="theme-dark bg-bg relative flex min-h-[100svh] flex-col overflow-hidden" data-theme="dark" data-service-hero>
    <div class="pointer-events-none absolute inset-0" aria-hidden="true">
      <div class="hero-mesh absolute inset-0"><span></span><span></span><span></span></div>
      <div class="hero-grid absolute inset-0"></div>
    </div>

    <!-- Órbita 360 -->
    <div class="pointer-events-none absolute -right-[34vw] top-[18%] aspect-square w-[78vw] opacity-45 sm:-right-[26vw] lg:-bottom-[10vw] lg:-right-[6vw] lg:top-auto lg:w-[min(50vw,860px)] lg:opacity-100" aria-hidden="true" data-orbit>
      <div class="absolute inset-0 rounded-full border border-brand-200/30"></div>
      <div class="spin-slow absolute inset-0" style="animation-duration: 40s">
        <span class="absolute left-1/2 top-0 h-3 w-3 -translate-x-1/2 -translate-y-1/2 rounded-full bg-signal shadow-[0_0_24px_rgba(165,139,255,.9)]"></span>
      </div>
      <div class="absolute inset-[16%] rounded-full border border-brand-200/25"></div>
      <div class="spin-slow absolute inset-[16%]" style="animation-duration: 26s; animation-direction: reverse">
        <span class="absolute bottom-0 left-1/2 h-2 w-2 -translate-x-1/2 translate-y-1/2 rounded-full bg-bone"></span>
      </div>
      <div class="absolute inset-[32%] rounded-full border border-dashed border-brand-200/30 spin-slow" style="animation-duration: 60s"></div>
      <div class="bg-brand absolute inset-[40%] rounded-full shadow-[0_0_120px_rgba(84,41,166,.6)]"></div>
      <svg class="spin-slow absolute inset-[6%] h-[88%] w-[88%]" style="animation-duration: 50s" viewBox="0 0 200 200">
        <defs><path id="orbit-text" d="M100,100 m-92,0 a92,92 0 1,1 184,0 a92,92 0 1,1 -184,0"/></defs>
        <text class="fill-bone/50 font-mono text-[6px] uppercase tracking-[0.5em]"><textPath href="#orbit-text"><%= S.method.steps.map(s => s.title).join(' · ') %> · <%= S.method.steps.map(s => s.title).join(' · ') %> · </textPath></text>
      </svg>
    </div>

    <div class="container-x relative flex flex-1 flex-col pb-10 pt-28 lg:pb-14 lg:pt-32">
      <div class="grid grid-cols-2 gap-6 border-t border-fg/10 pt-4 font-mono text-[0.65rem] uppercase tracking-[0.18em] text-fg/55 lg:grid-cols-6" data-hero-fade>
        <span><%= S.eyebrow %></span>
        <span class="hidden lg:block"><%= S.name %></span>
        <span class="text-right lg:col-start-6">1250</span>
      </div>

      <h1 class="display my-auto py-12 text-[clamp(4rem,15vw,15rem)] leading-[0.86]" aria-label="<%= S.title.join(' ') %>">
        <% S.title.forEach((w, i) => { %>
          <span class="line-mask" aria-hidden="true"><span class="block <%= i === 1 ? 'pl-[8vw]' : '' %> <%= i === 2 ? 'text-brand' : '' %>" data-hero-line><%= w %></span></span>
        <% }) %>
      </h1>

      <div class="grid items-end gap-8 lg:grid-cols-6" data-hero-fade>
        <div class="lg:col-span-3">
          <p class="max-w-xl text-[clamp(1.35rem,2.2vw,2rem)] font-medium leading-[1.2] tracking-[-0.025em]"><%= S.lead %></p>
          <p class="mt-4 max-w-md text-fg/60"><%= S.sub %></p>
        </div>
        <div class="flex flex-wrap items-center gap-3 lg:col-span-3 lg:justify-end">
          <a href="#metodologia" class="btn-pill" data-magnetic data-anchor><span><%= S.method.eyebrow %></span><span aria-hidden="true">↓</span></a>
          <a href="<%= url('contact') %>" class="btn-brand" data-magnetic><span><%= S.cta.button %></span><span aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================ NUESTRA MIRADA (claro) -->
  <section class="theme-light bg-bg" data-theme="light">
    <div class="container-x section-y">
      <p class="eyebrow mb-12 lg:mb-20">(01) — <%= S.view.eyebrow %></p>
      <div class="grid gap-16 lg:grid-cols-12">
        <ul class="self-start border-t border-fg/15 lg:sticky lg:top-32 lg:col-span-4" data-stagger>
          <% S.view.scope.forEach((item, i) => { %>
            <li class="group flex items-baseline gap-4 border-b border-fg/15 py-4 text-xl font-medium tracking-tight lg:text-2xl">
              <span class="font-mono text-xs text-fg/40">0<%= i + 1 %></span>
              <span class="transition-transform duration-500 group-hover:translate-x-2"><%= item %></span>
            </li>
          <% }) %>
        </ul>
        <article class="lg:col-span-7 lg:col-start-6">
          <h2 class="display accent-em text-[clamp(2.4rem,5vw,5.2rem)]" data-split-lines><%- S.view.title %></h2>
          <p class="mt-12 text-[clamp(1.3rem,2vw,1.8rem)] font-medium leading-[1.3] tracking-[-0.02em]" data-scrub-words><%= S.view.body[0] %></p>
          <div class="mt-12 grid gap-8 border-t border-fg/15 pt-10 text-lg leading-relaxed text-fg/70 md:grid-cols-2" data-stagger>
            <% S.view.body.slice(1).forEach(p => { %><p><%= p %></p><% }) %>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- ============================================================ METODOLOGÍA (oscuro) -->
  <section id="metodologia" class="theme-dark bg-bg relative overflow-hidden" data-theme="dark" data-method>
    <div class="container-x section-y">
      <div class="mb-16 grid gap-8 lg:mb-24 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-6">
          <p class="eyebrow mb-6">(02) — <%= S.method.eyebrow %></p>
          <h2 class="display text-huge accent-em" data-split-lines><%- S.method.title %></h2>
        </div>
        <p class="text-xl leading-snug text-fg/70 lg:col-span-5 lg:col-start-8 lg:text-2xl"><%= S.method.lead %></p>
      </div>

      <div class="relative">
        <!-- línea de progreso -->
        <div class="absolute left-[1.35rem] top-0 h-full w-px bg-fg/15 xl:left-0 xl:top-[1.35rem] xl:h-px xl:w-full" aria-hidden="true">
          <span class="absolute inset-0 origin-top scale-y-0 bg-signal xl:origin-left xl:scale-x-0 xl:scale-y-100" data-method-line></span>
        </div>

        <ol class="relative grid gap-6 xl:grid-cols-5 xl:gap-4">
          <% S.method.steps.forEach((s, i) => { %>
            <li class="group relative pl-16 xl:pl-0 xl:pt-16" data-step>
              <span class="absolute left-0 top-0 grid h-11 w-11 place-items-center rounded-full border border-fg/25 bg-bg font-mono text-xs transition-all duration-500 group-[.is-active]:border-transparent group-[.is-active]:bg-brand-600 group-[.is-active]:text-bone" data-step-dot>0<%= i + 1 %></span>
              <div class="flex h-full min-h-[14rem] flex-col justify-between rounded-3xl border border-fg/12 bg-card p-6 transition-all duration-700 ease-[var(--ease-expo)] group-[.is-active]:border-brand-400/60 group-[.is-active]:bg-brand-900/60 xl:min-h-[19rem] xl:p-7">
                <h3 class="display text-[clamp(1.9rem,6vw,2.6rem)] xl:text-[clamp(1.35rem,1.7vw,2.4rem)]"><%= s.title %></h3>
                <p class="mt-8 leading-relaxed text-fg/65"><%= s.text %></p>
              </div>
            </li>
          <% }) %>
        </ol>

        <p class="mt-10 flex items-center gap-3 pl-16 font-mono text-[0.68rem] uppercase tracking-[0.18em] text-fg/55 xl:justify-end xl:pl-0">
          <svg class="spin-slow h-5 w-5 text-signal" style="animation-duration: 6s" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M20 12a8 8 0 1 1-2.34-5.66M20 4v4h-4"/></svg>
          <%= S.method.loop %>
        </p>
      </div>
    </div>
  </section>

  <!-- ============================================================ ALCANCE (violeta) -->
  <section class="theme-brand bg-brand relative overflow-hidden" data-theme="brand">
    <div class="hero-mesh pointer-events-none absolute inset-0 opacity-50" aria-hidden="true"><span></span><span></span><span></span></div>
    <div class="container-x section-y relative">
      <div class="mb-16 grid gap-8 lg:mb-20 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-6">
          <p class="eyebrow mb-6 !text-fg/75">(03) — <%= S.scope.eyebrow %></p>
          <h2 class="display text-huge accent-em" data-split-lines><%- S.scope.title %></h2>
        </div>
        <p class="text-xl leading-snug text-fg/80 lg:col-span-5 lg:col-start-8 lg:text-2xl"><%= S.scope.lead %></p>
      </div>

      <div class="grid gap-4 md:grid-cols-2" data-stagger>
        <% S.scope.items.forEach((item, i) => { %>
          <article class="group relative overflow-hidden rounded-3xl border border-bone/25 p-7 transition-colors duration-500 hover:bg-bone/10 lg:p-10">
            <div class="flex items-start justify-between gap-6">
              <span class="font-mono text-xs text-fg/60">0<%= i + 1 %></span>
              <span class="grid h-10 w-10 place-items-center rounded-full border border-bone/30 transition-all duration-500 group-hover:rotate-45 group-hover:bg-bone group-hover:text-brand-600" aria-hidden="true">↗</span>
            </div>
            <h3 class="display mt-10 text-[clamp(1.9rem,3vw,3rem)] text-brand-200 lg:mt-16"><%= item.title %></h3>
            <p class="mt-5 max-w-xl leading-relaxed text-fg/78"><%= item.text %></p>
          </article>
        <% }) %>
      </div>
    </div>
  </section>

  <!-- ============================================================ PLANIFICACIÓN (claro) -->
  <section class="theme-light bg-bg" data-theme="light">
    <div class="container-x section-y">
      <div class="mb-16 grid gap-8 lg:mb-20 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-6">
          <p class="eyebrow mb-6">(04) — <%= S.planning.eyebrow %></p>
          <h2 class="display text-huge accent-em" data-split-lines><%- S.planning.title %></h2>
        </div>
        <p class="text-xl leading-snug text-fg/70 lg:col-span-5 lg:col-start-8 lg:text-2xl"><%= S.planning.lead %></p>
      </div>

      <div class="grid gap-4 lg:grid-cols-3" data-stagger>
        <% S.planning.cards.forEach((c, i) => { const featured = i === 1; %>
          <article class="<%= featured ? 'theme-brand bg-brand' : 'bg-card' %> flex flex-col rounded-3xl p-7 lg:p-9">
            <span class="self-start rounded-full border border-current/40 px-3 py-1.5 font-mono text-[0.62rem] uppercase tracking-[0.14em]"><%= c.tag %></span>
            <h3 class="display mt-10 text-[clamp(2rem,2.8vw,2.8rem)]"><%= c.title %></h3>
            <ul class="mt-8">
              <% c.items.forEach(item => { %>
                <li class="flex gap-3 border-t border-fg/15 py-3.5 leading-snug"><span class="<%= featured ? 'text-brand-200' : 'text-accent' %> font-semibold" aria-hidden="true">+</span><span><%= item %></span></li>
              <% }) %>
            </ul>
          </article>
        <% }) %>
      </div>
    </div>
  </section>

  <!-- ============================================================ CIERRE (oscuro) -->
  <section class="theme-dark bg-bg" data-theme="dark">
    <div class="container-x section-y grid gap-12 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-8">
        <p class="eyebrow mb-6"><%= S.cta.eyebrow %></p>
        <h2 class="display text-giant accent-em" data-split-lines><%- S.cta.title %></h2>
      </div>
      <div class="border-t border-fg/15 lg:col-span-4">
        <a href="<%= url('contact') %>" class="group flex items-center justify-between border-b border-fg/15 py-6 text-xl font-medium tracking-tight" data-cursor="<%= t.cursor.write %>">
          <span class="transition-transform duration-500 group-hover:translate-x-2"><%= S.cta.button %></span><span class="text-accent">→</span>
        </a>
        <a href="mailto:<%= agency.email %>" class="group flex items-center justify-between border-b border-fg/15 py-6 text-xl font-medium tracking-tight">
          <span class="transition-transform duration-500 group-hover:translate-x-2"><%= agency.email %></span><span class="text-accent">↗</span>
        </a>
      </div>
    </div>
  </section>
</main>

<%- include('partials/footer') %>
