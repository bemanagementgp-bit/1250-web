<%- include('partials/head') %>

<main id="main" class="theme-light bg-bg" data-theme="light">
  <section class="container-x section-top">
    <div class="flex items-end justify-between gap-6">
      <h1 class="display text-mega accent-em"><span class="line-mask"><span class="block" data-hero-line><%- t.works.title %></span></span></h1>
      <p class="eyebrow mb-[2vw] hidden text-right sm:block" data-fade><%= t.works.eyebrow %><br><span class="text-fg"><%= works.length %> <%= t.works.cases %></span></p>
    </div>

    <div class="mt-12 flex flex-col gap-6 border-t border-fg/15 pt-6 lg:flex-row lg:items-center lg:justify-between" data-fade>
      <div class="flex flex-wrap gap-2" role="toolbar" aria-label="<%= t.works.filter %>">
        <button type="button" class="chip" data-filter="all" aria-pressed="true"><%= t.works.all %> <sup class="font-mono"><%= works.length %></sup></button>
        <% disciplines.forEach(d => { const c = works.filter(w => w.disciplines.includes(d)).length; if (!c) return; %>
          <button type="button" class="chip" data-filter="<%= d %>" aria-pressed="false"><%= t.disciplines[d] %> <sup class="font-mono"><%= c %></sup></button>
        <% }) %>
      </div>
      <div class="flex items-center gap-1 self-start rounded-full border border-fg/15 p-1 lg:self-auto" role="group" aria-label="<%= t.works.view %>">
        <button type="button" class="rounded-full px-4 py-2 text-sm transition-colors aria-pressed:bg-fg aria-pressed:text-bg" data-view="grid" aria-pressed="true"><%= t.works.grid %></button>
        <button type="button" class="rounded-full px-4 py-2 text-sm transition-colors aria-pressed:bg-fg aria-pressed:text-bg" data-view="list" aria-pressed="false"><%= t.works.list %></button>
      </div>
    </div>
  </section>

  <section class="container-x pb-32 pt-14 lg:pb-48 lg:pt-20" data-view-panel="grid">
    <ul class="grid gap-x-6 gap-y-14 sm:grid-cols-2 lg:grid-cols-3 lg:gap-x-8 lg:gap-y-20" data-grid>
      <% works.forEach((w, i) => { %>
        <li data-work data-disciplines="<%= w.disciplines.join('|') %>" class="<%= i % 3 === 1 ? 'lg:translate-y-20' : '' %>">
          <a href="<%= url('work', w.slug) %>" class="group block" data-cursor="<%= t.cursor.case %>">
            <div class="relative aspect-[4/5] overflow-hidden rounded-2xl bg-card">
              <div class="img-reveal absolute inset-0" data-reveal>
                <%- pic(w.cover, { alt: w.title, sizes: '(min-width:1024px) 31vw, (min-width:640px) 46vw, 90vw', cls: 'block h-full w-full', imgCls: 'h-full w-full scale-[1.15] object-cover transition-transform duration-[1.4s] ease-[var(--ease-expo)] group-hover:scale-105', attrs: 'data-parallax-img' }) %>
              </div>
              <div class="absolute inset-0 bg-brand-900/0 transition-colors duration-500 group-hover:bg-brand-900/25"></div>
              <span class="absolute left-4 top-4 rounded-full bg-bone/85 px-2.5 py-1 font-mono text-[0.62rem] text-ink backdrop-blur"><%= String(i + 1).padStart(2, '0') %></span>
            </div>
            <div class="mt-5 flex items-start justify-between gap-4">
              <div>
                <h2 class="text-2xl font-semibold tracking-tight"><%= w.title %></h2>
                <p class="mt-1 font-serif text-lg italic text-fg/60"><%= w.tagline %></p>
              </div>
              <span class="eyebrow mt-1.5 max-w-[9rem] shrink-0 text-right"><%= w.industry.split(' / ')[0] %></span>
            </div>
          </a>
        </li>
      <% }) %>
    </ul>
  </section>

  <section class="container-x hidden pb-32 pt-14 lg:pb-48 lg:pt-20" data-view-panel="list">
    <div class="pointer-events-none fixed left-0 top-0 z-40 hidden aspect-[4/5] w-72 overflow-hidden rounded-xl opacity-0 lg:block" data-list-preview>
      <% works.forEach(w => { %><div class="absolute inset-0 opacity-0" data-preview-img="<%= w.slug %>"><%- pic(w.cover, { sizes: '18rem', cls: 'block h-full w-full', imgCls: 'h-full w-full object-cover' }) %></div><% }) %>
    </div>
    <ul class="border-t border-fg/15" data-list>
      <% works.forEach((w, i) => { %>
        <li data-work data-disciplines="<%= w.disciplines.join('|') %>">
          <a href="<%= url('work', w.slug) %>" class="group relative grid grid-cols-12 items-center gap-4 border-b border-fg/15 px-2 py-6 lg:py-8" data-list-row="<%= w.slug %>">
            <span class="bg-brand absolute inset-0 origin-bottom scale-y-0 transition-transform duration-500 ease-[var(--ease-expo)] group-hover:scale-y-100"></span>
            <span class="relative col-span-2 font-mono text-xs text-fg/50 transition-colors group-hover:text-bone/70 sm:col-span-1"><%= String(i + 1).padStart(2, '0') %></span>
            <span class="relative col-span-10 text-3xl font-semibold tracking-tight transition-all duration-500 group-hover:translate-x-4 group-hover:text-bone sm:col-span-5 lg:text-5xl"><%= w.title %></span>
            <span class="relative col-span-4 hidden text-sm text-fg/60 transition-colors group-hover:text-bone/80 sm:block"><%= w.services.join(' / ') %></span>
            <span class="relative col-span-2 hidden text-right text-sm text-fg/60 transition-colors group-hover:text-bone/80 sm:block"><%= w.location %></span>
          </a>
        </li>
      <% }) %>
    </ul>
  </section>
</main>

<%- include('partials/footer') %>
